{
  "name": "PDF Toolkit — Private PDF Tools",
  "short_name": "PDF Toolkit",
  "description": "16+ PDF tools that run 100% in your browser. No uploads, no tracking, no servers.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#3B82F6",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": { "application/pdf": [".pdf"] }
    }
  ]
}
